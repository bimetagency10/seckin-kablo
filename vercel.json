{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/katalog",
      "destination": "/katalog.html",
      "permanent": true
    },
    {
      "source": "/is-konumu/:yol*",
      "destination": "/iletisim.html",
      "permanent": true
    },
    {
      "source": "/cctv-kablolari",
      "destination": "/cctv-kablolari.html",
      "permanent": true
    },
    {
      "source": "/cerez-politikasi",
      "destination": "/cerez-politikasi.html",
      "permanent": true
    },
    {
      "source": "/data-kablolari",
      "destination": "/data-kablolari.html",
      "permanent": true
    },
    {
      "source": "/hakkimizda",
      "destination": "/hakkimizda.html",
      "permanent": true
    },
    {
      "source": "/iletisim",
      "destination": "/iletisim.html",
      "permanent": true
    },
    {
      "source": "/kablo-secim-rehberi",
      "destination": "/kablo-secim-rehberi.html",
      "permanent": true
    },
    {
      "source": "/koaksiyel-kablolar",
